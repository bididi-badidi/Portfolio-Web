# Client
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=EMAIL_JS_PUBLIC_KEY
NEXT_PUBLIC_AZURE_REMINDER_API_URL=REMINDER_API_URL


# Local Dev
NEXT_PUBLIC_LOCAL_REMINDER_API_URL=http://localhost:5241/api
NEXT_PUBLIC_DEV_MODE=True

# Server

# AWS Bucket
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=AWS_SECRET_ACCESS_KEY
AWS_BUCKET_NAME=zs-portfolio-website-bucket

# Expire at EXPIRY_DATE
REMINDER_API_TOKEN=REMINDER_TEMP_TOKEN

RESUME_SERVER_URL=RESUME_SERVER_URL
RESUME_API_KEY=RESUME_API_KEY

# Server-only portfolio chatbot
OPENAI_API_KEY=
# Optional; defaults to Luna
OPENAI_MODEL=gpt-5.6-luna

# Shared /api/chatbot quota store. Both are required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional quota tuning (defaults shown).
CHATBOT_RATE_LIMIT_PER_IP_MAX=10
CHATBOT_RATE_LIMIT_WINDOW_SECONDS=60
CHATBOT_DAILY_REQUEST_MAX=500
CHATBOT_RATE_LIMIT_REDIS_TIMEOUT_MS=2000
CHATBOT_RATE_LIMIT_IP_HEADER=x-forwarded-for
CHATBOT_RATE_LIMIT_KEY_PREFIX=portfolio:chatbot
