{
  "permissions": {
    "allow": [
      "Skill(coding-workflow)",
      "Skill(git-workflow)",
      "Skill(git-worktree)",
      "Skill(github-workflows)",
      "Skill(issue-creation)",
      "Skill(task-decompose)",
      "Skill(write-skills)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git remote -v)",
      "Bash(git remote get-url origin)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git worktree list)",
      "Bash(git fetch origin)",
      "Bash(git fetch --prune origin)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run test:*)",
      "Bash(bun test)",
      "Bash(bun test *)",
      "Bash(bun run test)",
      "Bash(bun run test *)",
      "Bash(bun run test:*)"
    ]
  },
  "mcp": {
    "allowed": ["memory"],
    "excluded": []
  },
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {
        "MEMORY_FILE_PATH": ".ai/assets/memory.jsonl"
      }
    }
  }
}
